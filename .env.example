# WenzWork Host first-start configuration
#
# The only values an operator must choose before starting Host are the default
# administrator email and password. When DATABASE_URL and REDIS_URL are absent,
# the portable Host package generates private credentials and starts managed
# PostgreSQL/Redis Docker containers. The administrator completes the public
# URL, production database/Redis, system email, and other settings after the
# first sign-in; Host then writes them back to this installation's .env.

SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=

# Internal first-login state. Do not set this to true by hand.
SYSTEM_SETUP_COMPLETED=false

# On first upgrade, the Host imports this legacy bootstrap key (or the
# automatically generated cache/host-secrets/release-access-key) into the
# database as a SHA-256 digest. After that, rotate it from Admin > Releases >
# Basic settings; environment/file values no longer override the database.
# Never commit the real value.
# RELEASE_ACCESS_KEY=release_replace-with-a-43-character-urlsafe-secretx
# RELEASE_ACCESS_KEY_FILE=cache/host-secrets/release-access-key
# RELEASE_PUSH_STORAGE_DIR=cache/release-push
