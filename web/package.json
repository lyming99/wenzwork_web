{
  "name": "@wenzwork/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build && node scripts/generate-sitemap.mjs && node scripts/generate-sites-worker.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@unhead/vue": "^2.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "hash-wasm": "4.12.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.39",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "happy-dom": "^20.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
