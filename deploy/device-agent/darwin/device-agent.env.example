# Replace the Access Key and pass this file to install.sh with --agent-env-file.
WENZWORK_CONTROL_URL=https://wenzwork.com
WENZWORK_DEVICE_ACCESS_KEY=device_replace_with_a_43_character_urlsafe_access_key
WENZWORK_DEVICE_STATE_FILE=/Library/Application Support/WenzWork/DeviceAgent/data/state/agent-state.json
WENZWORK_DEVICE_WORKSPACE=/Library/Application Support/WenzWork/DeviceAgent/data/workspace
WENZWORK_AGENT_SECRET_STORE=file
# Replace the IP with this device's reachable LAN/WAN address before enabling.
WENZWORK_DEVICE_DIRECT_ENABLED=false
WENZWORK_DEVICE_DIRECT_IP=127.0.0.1
WENZWORK_DEVICE_DIRECT_PORT=9443
# Optional; defaults to WENZWORK_DEVICE_ACCESS_KEY when direct mode is enabled.
# WENZWORK_DEVICE_DIRECT_ACCESS_KEY=device_replace_with_a_43_character_urlsafe_access_key
# WENZWORK_DEVICE_DIRECT_TLS_CERT_FILE=/Library/Application Support/WenzWork/DeviceAgent/config/direct-cert.pem
# WENZWORK_DEVICE_DIRECT_TLS_KEY_FILE=/Library/Application Support/WenzWork/DeviceAgent/config/direct-key.pem
# WENZWORK_AGENT_FEATURE_FLAGS=-terminal.interactive,-tasks.v2,-ai.tools
# WENZWORK_DEVICE_TLS_CA_FILE=/Library/Application Support/WenzWork/DeviceAgent/config/control-ca.pem
