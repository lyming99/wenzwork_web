# Replace the Access Key, restrict this file to Administrators, and pass it to Install.ps1.
WENZWORK_CONTROL_URL=https://wenzwork.com
WENZWORK_DEVICE_ACCESS_KEY=device_replace_with_a_43_character_urlsafe_access_key
WENZWORK_DEVICE_STATE_FILE=C:\ProgramData\WenzWork\DeviceAgent\data\state\agent-state.json
WENZWORK_DEVICE_WORKSPACE=C:\ProgramData\WenzWork\DeviceAgent\data\workspace
WENZWORK_AGENT_SECRET_STORE=native
# WENZWORK_AGENT_FEATURE_FLAGS=-terminal.interactive,-tasks.v2,-ai.tools
# WENZWORK_DEVICE_TLS_CA_FILE=C:\ProgramData\WenzWork\DeviceAgent\config\control-ca.pem
