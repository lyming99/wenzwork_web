# Control Plane address. HTTP is permitted only for localhost or loopback use.
WENZWORK_CONTROL_URL=http://localhost:8080

# Create this one-time value in Web: Account > Remote Devices.
WENZWORK_DEVICE_ACCESS_KEY=device_replace_with_your_one_time_access_key

# Keep this state file private and unique to this device.
WENZWORK_DEVICE_STATE_FILE=D:\WenzWork\agent\state.json

# Legacy workspace migrated idempotently into the multi-project registry.
WENZWORK_DEVICE_WORKSPACE=D:\WenzWork\workspace

# native: Windows DPAPI, macOS Keychain, Linux Secret Service (default).
# Set to file only as an explicit encrypted restricted-file fallback.
WENZWORK_AGENT_SECRET_STORE=native

# Optional direct Carrier listener. Replace the IP with a reachable address,
# open the TCP port in the device firewall, then switch enabled to true.
WENZWORK_DEVICE_DIRECT_ENABLED=false
WENZWORK_DEVICE_DIRECT_IP=127.0.0.1
WENZWORK_DEVICE_DIRECT_PORT=9443
# Optional native-client credential. When omitted, direct mode reuses
# WENZWORK_DEVICE_ACCESS_KEY without placing either key in a URL or log.
# WENZWORK_DEVICE_DIRECT_ACCESS_KEY=device_replace_with_a_43_character_urlsafe_access_key
# Optional WSS. Both files are required together; the certificate must contain
# WENZWORK_DEVICE_DIRECT_IP as an IP subjectAltName and be trusted by browsers.
# WENZWORK_DEVICE_DIRECT_TLS_CERT_FILE=D:\WenzWork\agent\direct-cert.pem
# WENZWORK_DEVICE_DIRECT_TLS_KEY_FILE=D:\WenzWork\agent\direct-key.pem

# Optional emergency rollout kill switch. Interactive terminal still requires
# an explicit per-project policy and dedicated Peer Scope when this is unset.
# WENZWORK_AGENT_FEATURE_FLAGS=-terminal.interactive

# Optional: extra CA PEM for a self-signed HTTPS Control Plane.
# WENZWORK_DEVICE_TLS_CA_FILE=D:\WenzWork\agent\control-ca.pem
