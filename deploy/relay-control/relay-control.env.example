APP_ENV=production
DATABASE_URL=postgres://wenzwork:<password>@postgres.internal:5432/wenzwork?sslmode=verify-full
RELAY_DIRECTORY_ADDR=:9443
RELAY_DIRECTORY_HEALTH_ADDR=127.0.0.1:9460
RELAY_DIRECTORY_TLS_CERTIFICATE_FILE=/etc/wenzwork/tls/relay-directory.crt
RELAY_DIRECTORY_TLS_PRIVATE_KEY_FILE=/etc/wenzwork/tls/relay-directory.key
RELAY_NODE_CA_CERTIFICATE_FILE=/etc/wenzwork/tls/relay-node-ca.crt
RELAY_SCHEDULER_HEALTH_ADDR=127.0.0.1:9462
REDIS_URL=rediss://relay-control:<password>@redis.internal:6379/0
