# The only required Relay host setting. The management service returns the
# installation binding, client-facing WS/WSS endpoint, plaintext WS listener, Redis connection,
# limits, and both Ticket verification-key sets after authentication.
RELAY_ACCESS_KEY=relay_REPLACE_WITH_THE_GENERATED_ACCESS_KEY

# Optional for private/on-premise builds whose management origin is different
# from the origin embedded in the Relay binary.
# HTTP and HTTPS are both supported. Prefer HTTPS outside a trusted private network.
# RELAY_MANAGEMENT_URL=https://control.example.com
