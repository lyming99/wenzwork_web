{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Routing-ready nodes",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(wenzwork_relay_routing_ready)", "legendFormat": "ready"}],
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active connections",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(wenzwork_relay_connections)", "legendFormat": "connections"}],
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Route rejections (5m)",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "sum(increase(wenzwork_relay_route_rejected_total[5m]))", "legendFormat": "rejected"}],
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Host heartbeat age",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "max(time() - wenzwork_relay_last_heartbeat_seconds)", "legendFormat": "seconds"}],
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"min": 0, "unit": "s"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connections by Relay",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"refId": "A", "expr": "wenzwork_relay_connections", "legendFormat": "{{instance}}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Handshake and route failures",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(wenzwork_relay_handshakes_failed_total[5m]))", "legendFormat": "handshake failures/s"},
        {"refId": "B", "expr": "sum(rate(wenzwork_relay_route_rejected_total[5m]))", "legendFormat": "route rejected/s"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue and write loop",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "sum(wenzwork_relay_queue_bytes)", "legendFormat": "queued bytes"},
        {"refId": "B", "expr": "max(wenzwork_relay_write_loop_lag_seconds)", "legendFormat": "write latency seconds"},
        {"refId": "C", "expr": "sum(wenzwork_relay_v2_queue_bytes)", "legendFormat": "v2 global queued bytes"},
        {"refId": "D", "expr": "sum(wenzwork_relay_v2_queue_budget_bytes)", "legendFormat": "v2 global queue budget"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Relay registration and routing state",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "wenzwork_relay_registered", "legendFormat": "{{instance}} registered"},
        {"refId": "B", "expr": "wenzwork_relay_routing_ready", "legendFormat": "{{instance}} routing ready"},
        {"refId": "C", "expr": "wenzwork_relay_draining", "legendFormat": "{{instance}} draining"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wenzwork", "relay"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "WenzWork Relay",
  "uid": "wenzwork-relay",
  "version": 1
}
